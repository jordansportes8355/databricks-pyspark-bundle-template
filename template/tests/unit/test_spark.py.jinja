"""Tests for the SparkSession factory."""

from __future__ import annotations

from pyspark.sql import SparkSession

from {{ package_name }}.spark import get_spark, is_databricks


def test_is_databricks_reads_runtime_env_var(monkeypatch):
    monkeypatch.delenv("DATABRICKS_RUNTIME_VERSION", raising=False)
    assert not is_databricks()

    monkeypatch.setenv("DATABRICKS_RUNTIME_VERSION", "{{ databricks_runtime }}")
    assert is_databricks()


def test_get_spark_applies_conf_with_and_without_prefix(spark: SparkSession):
    session = get_spark(conf={"sql.shuffle.partitions": 3, "spark.sql.adaptive.enabled": "false"})

    assert session is spark
    assert session.conf.get("spark.sql.shuffle.partitions") == "3"
    assert session.conf.get("spark.sql.adaptive.enabled") == "false"

    spark.conf.set("spark.sql.shuffle.partitions", "1")
    spark.conf.set("spark.sql.adaptive.enabled", "true")
