"""Tests for local secret retrieval."""

from __future__ import annotations

import pytest

from {{ package_name }}.secrets import get_secret


@pytest.fixture(autouse=True)
def _not_on_databricks(monkeypatch):
    monkeypatch.delenv("DATABRICKS_RUNTIME_VERSION", raising=False)


def test_get_secret_reads_env_var(monkeypatch):
    monkeypatch.setenv("MY_API_KEY", "s3cr3t")
    assert get_secret("scope", "key", env_var="MY_API_KEY") == "s3cr3t"


def test_get_secret_missing_raises_with_hint(monkeypatch):
    monkeypatch.delenv("MY_API_KEY", raising=False)
    with pytest.raises(RuntimeError, match="MY_API_KEY"):
        get_secret("scope", "key", env_var="MY_API_KEY")
