"""Tests for the job configuration."""

from __future__ import annotations

import pytest

from {{ package_name }}.config import Config


def test_table_is_fully_qualified():
    cfg = Config(catalog="main", schema="dev_jdoe")
    assert cfg.schema_name == "main.dev_jdoe"
    assert cfg.table("trips") == "main.dev_jdoe.trips"


def test_config_is_immutable():
    cfg = Config(catalog="main", schema="s")
    with pytest.raises(AttributeError):
        cfg.schema = "other"  # type: ignore[misc]
