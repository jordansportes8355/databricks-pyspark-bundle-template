"""Tests for the wheel entry point."""

from __future__ import annotations

from unittest.mock import MagicMock, patch

import pytest

from {{ package_name }}.config import Config
from {{ package_name }}.main import main


def test_main_creates_schema_and_runs_job():
    spark = MagicMock()
    job = MagicMock()

    with (
        patch("{{ package_name }}.main.get_spark", return_value=spark),
        patch.dict("{{ package_name }}.main._JOBS", {"example": job}),
    ):
        assert main(["--catalog", "main", "--schema", "dev_jdoe", "--log-level", "DEBUG"]) == 0

    spark.sql.assert_called_once_with("CREATE SCHEMA IF NOT EXISTS main.dev_jdoe")
    job.assert_called_once_with(spark, Config(catalog="main", schema="dev_jdoe"))


def test_main_requires_catalog_and_schema():
    with pytest.raises(SystemExit):
        main([])
