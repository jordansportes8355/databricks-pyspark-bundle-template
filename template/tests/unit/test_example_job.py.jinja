"""Unit tests for example_job — I/O mocked, transformations exercised."""

from __future__ import annotations

from unittest.mock import patch

from pyspark.sql import SparkSession

from {{ package_name }}.config import Config
from {{ package_name }}.jobs.example_job import SOURCE_TABLE, run

JOB = "{{ package_name }}.jobs.example_job"


def test_run_filters_trips_without_zip_and_writes(spark: SparkSession):
    source_df = spark.createDataFrame(
        [(10001, 10002), (None, 10003), (10004, None), (10005, 10006)],
        ["pickup_zip", "dropoff_zip"],
    )

    with (
        patch(f"{JOB}.read_table", return_value=source_df) as mock_read,
        patch(f"{JOB}.write_table") as mock_write,
    ):
        run(spark, Config(catalog="my_cat", schema="my_schema"))

    assert mock_read.call_args[0][1] == SOURCE_TABLE
    written_df, table = mock_write.call_args[0]
    assert table == "my_cat.my_schema.trips_processed"
    assert written_df.count() == 2
    assert "processing_date" in written_df.columns
