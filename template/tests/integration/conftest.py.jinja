"""Integration tests run on the workspace through Databricks Connect (make test-integration)."""

from __future__ import annotations

from pathlib import Path

import pytest

from {{ package_name }}.spark import has_databricks_connect

_HERE = Path(__file__).parent


def pytest_collection_modifyitems(config: pytest.Config, items: list[pytest.Item]) -> None:
    if has_databricks_connect():
        return
    skip = pytest.mark.skip(reason="needs databricks-connect: run `make test-integration`")
    for item in items:
        if _HERE in item.path.parents:
            item.add_marker(skip)
