resources:
  jobs:
    example_job:
      name: "{{ project_name }} - example (${bundle.target})"
      description: "Reads the source table, transforms it and writes to the job schema"

      tasks:
        - task_key: main # Add task if we want to chain jobs
          python_wheel_task:
            package_name: {{ package_name }}
            entry_point: {{ project_slug }}
            parameters:
              - "--job"
              - "example"
              - "--catalog"
              - "${var.catalog}"
              - "--schema"
              - "${var.schema}"
              - "--log-level"
              - "${var.log_level}"
{%- if compute == 'serverless' %}
          environment_key: default
{%- else %}
          job_cluster_key: {{ job_cluster_key }}
          libraries:
            - whl: ../dist/*.whl  # relative to this file
{%- endif %}

      schedule:
        quartz_cron_expression: "0 0 8 * * ?"
        timezone_id: "Europe/Paris"
        pause_status: ${var.schedule_status}

      email_notifications:
        on_failure:
          - {{ author_email }}
{%- if compute == 'serverless' %}

      environments:
        - environment_key: default
          spec:
            environment_version: "{{ serverless_environment }}"
            dependencies:
              - ../dist/*.whl  # relative to this file
{%- else %}

      job_clusters: ${var.job_clusters}
{%- endif %}
