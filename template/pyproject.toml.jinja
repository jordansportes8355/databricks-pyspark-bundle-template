[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
requires-python = ">={{ runtime.python }}"
dependencies = [
    "pyyaml>=6.0",
    "python-json-logger>=3.1",
]

[project.scripts]
{{ project_slug }} = "{{ package_name }}.main:main"

[dependency-groups]
# pyspark / delta-spark are provided by the cluster: local-only, pinned to DBR {{ databricks_runtime }}.
dev = [
    "pyspark{{ runtime.pyspark }}",
    "delta-spark{{ runtime.delta }}",
    "pytest>=8.0",
    "ruff>=0.16",
    "pre-commit>=3.0",
]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.ruff]
line-length = 120
src = ["src"]
target-version = "py{{ runtime.python | replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W", "UP"]
ignore = ["N812"]  # PySpark convention: `from pyspark.sql import functions as F`

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-v --tb=short"
