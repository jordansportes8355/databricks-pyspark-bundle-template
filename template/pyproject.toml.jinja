[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ package_name }}"
version = "0.1.0"
description = "{{ project_name }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
# Same Python minor version as the Databricks compute
requires-python = "~={{ runtime.python }}.0"
dependencies = [
    "python-json-logger>=3.1",
]

[project.scripts]
{{ project_slug }} = "{{ package_name }}.main:main"

[dependency-groups]
dev = [
    "pytest>=8.0",
    "ruff>=0.16",
    "pre-commit>=3.0",
]
# Local Spark + Delta for unit tests, pinned to the compute's Spark version.
local = [
    "pyspark{{ runtime.pyspark }}",
    "delta-spark{{ runtime.delta }}",
]
# Remote Spark on the workspace (make test-integration). Conflicts with pyspark.
dbconnect = [
    "databricks-connect{{ runtime.dbconnect }}",
]

[tool.uv]
default-groups = ["dev", "local"]
conflicts = [[{ group = "local" }, { group = "dbconnect" }]]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.ruff]
line-length = 120
src = ["src"]
target-version = "py{{ runtime.python | replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W", "UP"]
ignore = ["N812"]  # PySpark convention: `from pyspark.sql import functions as F`

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-v --tb=short"
