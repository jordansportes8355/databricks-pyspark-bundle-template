[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
requires-python = ">={{ python_version }}"
dependencies = [
    "pydantic>=2.0",
    "pyyaml>=6.0",
    "python-json-logger>=3.1",
]

[project.scripts]
{{ project_slug }} = "{{ package_name }}.main:main"

[project.optional-dependencies]
# Pinned to the Spark / Delta versions shipped with DBR {{ databricks_runtime }}.
# pyspark is provided by the cluster, so it is never a runtime dependency.
local = [
    "pyspark{{ spark_version_spec }}",
    "delta-spark{{ delta_version_spec }}",
]
dev = [
    "pyspark{{ spark_version_spec }}",
    "delta-spark{{ delta_version_spec }}",
    "pytest>=8.0",
    "chispa>=0.9",
    "ruff>=0.16",
    "pre-commit>=3.0",
]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.ruff]
line-length = 120
src = ["src"]
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W", "UP"]
ignore = ["N812"]  # PySpark convention: `from pyspark.sql import functions as F`

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-v --tb=short"
