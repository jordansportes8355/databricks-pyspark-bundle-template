.PHONY: install lint format test test-integration validate deploy-dev run-dev clean

# Databricks Connect lives in its own venv: it cannot coexist with pyspark.
DBCONNECT = UV_PROJECT_ENVIRONMENT=.venv-dbconnect uv run --no-default-groups --group dev --group dbconnect

install:
	uv sync
	@git rev-parse --git-dir >/dev/null 2>&1 || git init -q  # pre-commit needs a git repo
	uv run pre-commit install

lint:
	uv run ruff check src/ tests/
	uv run ruff format --check src/ tests/

format:
	uv run ruff format src/ tests/
	uv run ruff check --fix src/ tests/

test:
	uv run pytest tests/unit/

# Runs on the workspace through Databricks Connect (needs Databricks auth)
test-integration:
	$(DBCONNECT) pytest tests/integration/

validate:
	databricks bundle validate

# staging / prod are deployed by CI only (push to main, v* tag)
deploy-dev:
	databricks bundle deploy --target dev

run-dev: deploy-dev
	databricks bundle run --target dev {{ package_name }}_job

clean:
	rm -rf dist/ .pytest_cache/ spark-warehouse/ metastore_db/ derby.log
