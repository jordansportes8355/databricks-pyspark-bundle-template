"""Secret retrieval: Databricks secret scopes, env vars for local unit tests."""

from __future__ import annotations

import os

from {{ package_name }}.spark import has_databricks_connect, is_databricks


def get_secret(scope: str, key: str, env_var: str | None = None) -> str:
    """Return a secret from a Databricks secret scope, or from ``env_var`` locally.

    On Databricks and through Databricks Connect the secret scope is always used and a
    missing secret raises; the env var fallback only applies to local unit tests.
    """
    if is_databricks():
        from pyspark.dbutils import DBUtils  # type: ignore[import]
        from pyspark.sql import SparkSession

        return DBUtils(SparkSession.builder.getOrCreate()).secrets.get(scope=scope, key=key)

    if has_databricks_connect():
        from databricks.sdk import WorkspaceClient

        return WorkspaceClient().dbutils.secrets.get(scope=scope, key=key)

    if env_var and (value := os.getenv(env_var)):
        return value

    hint = f" Set env var {env_var!r} for local use." if env_var else ""
    raise RuntimeError(f"Secret '{scope}/{key}' not found.{hint}")
