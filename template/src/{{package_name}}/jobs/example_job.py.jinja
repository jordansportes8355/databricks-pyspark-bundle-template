"""Example job: read the NYC taxi sample → transform → write to the job schema."""

from __future__ import annotations

import logging

from pyspark.sql import SparkSession

from {{ package_name }}.config import Config
from {{ package_name }}.io import read_table, write_table
from {{ package_name }}.transformations.example import add_processing_date, filter_non_null

logger = logging.getLogger(__name__)

# Available in every Databricks workspace — replace with your own source.
SOURCE_TABLE = "samples.nyctaxi.trips"
OUTPUT_TABLE = "trips_processed"


def run(spark: SparkSession, cfg: Config) -> None:
    """Read the source table, drop trips without zip codes, write the result."""
    output = cfg.table(OUTPUT_TABLE)

    logger.info("Reading from %s", SOURCE_TABLE)
    df = read_table(spark, SOURCE_TABLE)

    logger.info("Applying transformations")
    df = filter_non_null(df, "pickup_zip", "dropoff_zip")
    df = add_processing_date(df)

    logger.info("Writing to %s", output)
    write_table(df, output, mode="overwrite")
    logger.info("Done writing %s", output)
