"""JSON logging to stdout, picked up by the Databricks driver logs."""

from __future__ import annotations

import logging.config


def configure_logging(level: str = "INFO") -> None:
    """Configure the root logger with a JSON formatter at ``level``."""
    logging.config.dictConfig(
        {
            "version": 1,
            "disable_existing_loggers": False,
            "formatters": {
                "json": {
                    "()": "pythonjsonlogger.json.JsonFormatter",
                    "format": "%(asctime)s %(name)s %(levelname)s %(message)s",
                },
            },
            "handlers": {
                "console": {"class": "logging.StreamHandler", "formatter": "json", "stream": "ext://sys.stdout"},
            },
            "root": {"level": level.upper(), "handlers": ["console"]},
            "loggers": {"py4j": {"level": "WARNING"}, "pyspark": {"level": "WARNING"}},
        }
    )
