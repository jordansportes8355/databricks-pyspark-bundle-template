"""Entry point for Databricks python_wheel_task."""

from __future__ import annotations

import argparse
import logging
import sys

from {{ package_name }}.config import ENVS, load_config
from {{ package_name }}.jobs.example_job import run as run_example
from {{ package_name }}.logger import configure_logging
from {{ package_name }}.spark import get_spark

logger = logging.getLogger(__name__)

_JOBS = {
    "example": run_example,
}


def main() -> int:
    parser = argparse.ArgumentParser(description="{{ project_name }}")
    parser.add_argument("--env", default="dev", choices=ENVS)
    parser.add_argument("--job", default="example", choices=list(_JOBS))
    args = parser.parse_args()

    cfg = load_config(args.env)
    configure_logging(cfg.app.log_level)
    spark = get_spark(cfg.app.name, cfg.spark)

    logger.info("Starting job=%s env=%s", args.job, args.env)
    _JOBS[args.job](spark, cfg)
    logger.info("Job completed successfully")
    return 0


if __name__ == "__main__":
    sys.exit(main())
