"""SparkSession factory: cluster session, Databricks Connect, or local Spark + Delta."""

from __future__ import annotations

import importlib.util
import os

from pyspark.sql import SparkSession


def is_databricks() -> bool:
    """True when running on Databricks compute (set by the runtime)."""
    return "DATABRICKS_RUNTIME_VERSION" in os.environ


def has_databricks_connect() -> bool:
    """True when databricks-connect is installed (``make test-integration`` environment)."""
    try:
        return importlib.util.find_spec("databricks.connect") is not None
    except ModuleNotFoundError:  # parent "databricks" package absent
        return False


def get_spark(app_name: str = "{{ project_name }}") -> SparkSession:
    """Return the SparkSession for the current environment.

    - On Databricks: the session of the job compute.
    - With databricks-connect installed: a remote session on the workspace, using the
      standard Databricks auth (env vars or ~/.databrickscfg profile). Falls back to
      serverless compute when no cluster is configured.
    - Otherwise: a local session with Delta Lake, for unit tests.
    """
    if is_databricks():
        return SparkSession.builder.getOrCreate()
    if has_databricks_connect():
        return _connect_session()
    return _local_session(app_name)


def _connect_session() -> SparkSession:
    from databricks.connect import DatabricksSession
    from databricks.sdk.core import Config

    cfg = Config()
    if not (cfg.cluster_id or cfg.serverless_compute_id or os.environ.get("SPARK_REMOTE")):
        os.environ["DATABRICKS_SERVERLESS_COMPUTE_ID"] = "auto"
    return DatabricksSession.builder.getOrCreate()


def _local_session(app_name: str) -> SparkSession:
    # delta-spark is in the local dependency group only — import lazily.
    from delta import configure_spark_with_delta_pip

    builder = (
        SparkSession.builder.appName(app_name)
        .master("local[*]")
        .config("spark.ui.enabled", "false")
        .config("spark.sql.shuffle.partitions", "4")
        .config("spark.sql.extensions", "io.delta.sql.DeltaSparkSessionExtension")
        .config(
            "spark.sql.catalog.spark_catalog",
            "org.apache.spark.sql.delta.catalog.DeltaCatalog",
        )
    )
    return configure_spark_with_delta_pip(builder).getOrCreate()
