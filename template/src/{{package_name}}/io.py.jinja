"""Delta I/O helpers — Unity Catalog tables and raw paths."""

from __future__ import annotations

from typing import Literal

from pyspark.sql import DataFrame, SparkSession


def read_table(spark: SparkSession, table: str) -> DataFrame:
    """Read a Delta table from Unity Catalog (catalog.schema.table)."""
    return spark.read.table(table)


def read_path(spark: SparkSession, path: str) -> DataFrame:
    """Read Delta from an explicit path (S3, ADLS, GCS or UC Volume)."""
    return spark.read.format("delta").load(path)


def write_table(
    df: DataFrame,
    table: str,
    mode: Literal["overwrite", "append"] = "overwrite",
    partition_by: list[str] | None = None,
    schema_evolution: bool = False,
) -> None:
    """Write a DataFrame to a Delta table in Unity Catalog.

    Args:
        df: DataFrame to persist.
        table: Fully qualified name (catalog.schema.table).
        mode: 'overwrite' replaces the table; 'append' adds rows.
        partition_by: Optional list of partition columns.
        schema_evolution: If True, allows schema changes:
            - append: new columns are added (mergeSchema).
            - overwrite: schema and partitioning are replaced (overwriteSchema).
    """
    writer = df.write.format("delta").mode(mode)
    if schema_evolution:
        option = "overwriteSchema" if mode == "overwrite" else "mergeSchema"
        writer = writer.option(option, "true")
    if partition_by:
        writer = writer.partitionBy(*partition_by)
    writer.saveAsTable(table)
