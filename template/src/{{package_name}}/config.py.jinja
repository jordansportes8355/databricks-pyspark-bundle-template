"""Job configuration, built from the parameters passed by the bundle (see databricks.yml)."""

from __future__ import annotations

from dataclasses import dataclass


@dataclass(frozen=True)
class Config:
    catalog: str
    schema: str

    @property
    def schema_name(self) -> str:
        """Fully qualified schema: catalog.schema."""
        return f"{self.catalog}.{self.schema}"

    def table(self, name: str) -> str:
        """Fully qualified table name in the job schema: catalog.schema.name."""
        return f"{self.schema_name}.{name}"
