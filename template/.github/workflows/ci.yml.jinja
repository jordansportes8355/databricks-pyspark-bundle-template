name: CI

on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:
    branches: [main]
  workflow_dispatch:

# Least privilege for GITHUB_TOKEN
permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  # Only cancel PR runs: killing a deploy can leave the bundle deployment lock behind
  cancel-in-progress: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}

# Databricks auth: OAuth machine-to-machine with a service principal.
# Create the secrets DATABRICKS_HOST, DATABRICKS_CLIENT_ID and DATABRICKS_CLIENT_SECRET
# in each GitHub environment (no-prod, production).
# Secrets are injected only in the jobs that need them (never in lint-and-test).

jobs:
  lint-and-test:
    runs-on: ubuntu
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "{{ runtime.java }}"

      - uses: astral-sh/setup-uv@v10.2.0  # Python version read from .python-version
        with:
            enable-cache: true

      - name: Install dependencies
        run: uv sync --locked

      - name: Lint
        run: make lint

      - name: Unit tests (local Spark)
        run: make test

  bundle-validate:
    runs-on: ubuntu
    needs: lint-and-test
    # Secrets are not available on PRs from forks
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
    environment: no-prod
    timeout-minutes: 10
    env:
      DATABRICKS_TOKEN: {% raw %}${{ secrets.DATABRICKS_TOKEN_DEV }}{% endraw %}
    steps:
      - uses: actions/checkout@v4
      - uses: databricks/setup-cli@v1.18.0
      - name: Validate no-prod bundle
        run: databricks bundle validate --target no-prod

  deploy-no-prod:
    runs-on: ubuntu
    needs: bundle-validate
    if: {% raw %}github.ref == 'refs/heads/main'{% endraw %}
    environment: no-prod
    timeout-minutes: 60
    concurrency:
      group: deploy-no-prod
      cancel-in-progress: false
    env:
      DATABRICKS_TOKEN: {% raw %}${{ secrets.DATABRICKS_TOKEN_DEV }}{% endraw %}
    steps:
      - uses: actions/checkout@v4

      - uses: astral-sh/setup-uv@v10.2.0  # Python version read from .python-version
        with:
            enable-cache: true

      - uses: databricks/setup-cli@v1.18.0

      # The bundle builds the wheel itself (see artifacts in databricks.yml)
      - name: Deploy to no-prod
        run: databricks bundle deploy --target no-prod

      - name: Run example_job on no-prod
        run: databricks bundle run --target no-prod example_job

      - name: Install dependencies
        run: uv sync --locked

      # Databricks Connect on {% if compute == 'job_cluster' %}serverless unless DATABRICKS_CLUSTER_ID is set{% else %}serverless{% endif %}
      - name: Integration tests
        run: make test-integration

  deploy-prod:
    runs-on: ubuntu
    needs: bundle-validate
    if: {% raw %}startsWith(github.ref, 'refs/tags/v'){% endraw %}
    environment: production  # add required reviewers on this environment in GitHub
    timeout-minutes: 30
    concurrency:
      group: deploy-prod
      cancel-in-progress: false
    env:
      DATABRICKS_TOKEN: {% raw %}${{ secrets.DATABRICKS_TOKEN_PROD }}{% endraw %}
    steps:
      - uses: actions/checkout@v4
        with:
            fetch-depth: 0  # needed to check the tag ancestry against main

      - name: Verify tag is on main
        run: |
          if ! git merge-base --is-ancestor "$GITHUB_SHA" origin/main; then
            echo "::error::Tag ${GITHUB_REF_NAME} does not point to a commit on main"
            exit 1
          fi

      - name: Verify tag matches project version
        run: |
          version=$(python3 -c "import tomllib; print(tomllib.load(open('pyproject.toml','rb'))['project']['version'])")
          if [ "v${version}" != "${GITHUB_REF_NAME}" ]; then
            echo "::error::Tag ${GITHUB_REF_NAME} does not match pyproject version ${version}"
            exit 1
          fi

      - uses: astral-sh/setup-uv@v10.2.0  # Python version read from .python-version
        with:
            enable-cache: true

      - uses: databricks/setup-cli@v1.18.0

      - name: Validate prod bundle
        run: databricks bundle validate --target prod

      - name: Deploy to production
        run: databricks bundle deploy --target prod --fail-on-active-runs
