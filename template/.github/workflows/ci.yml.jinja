name: CI

on:
  push:
    branches: [main, develop]
    tags: ["v*"]
  pull_request:
    branches: [main]

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

# Databricks auth: OAuth machine-to-machine with a service principal.
# Create the secrets DATABRICKS_HOST, DATABRICKS_CLIENT_ID and DATABRICKS_CLIENT_SECRET
# in each GitHub environment (staging, production).
env:
  {% raw %}DATABRICKS_HOST: ${{ secrets.DATABRICKS_HOST }}
  DATABRICKS_CLIENT_ID: ${{ secrets.DATABRICKS_CLIENT_ID }}
  DATABRICKS_CLIENT_SECRET: ${{ secrets.DATABRICKS_CLIENT_SECRET }}{% endraw %}

jobs:
  lint-and-test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: "{{ runtime.java }}"

      - uses: astral-sh/setup-uv@v10.2.0  # Python version read from .python-version

      - name: Install dependencies
        run: uv sync

      - name: Lint
        run: make lint

      - name: Unit tests
        run: make test

  bundle-validate:
    runs-on: ubuntu-latest
    needs: lint-and-test
    environment: staging
    steps:
      - uses: actions/checkout@v7
      - uses: databricks/setup-cli@v1.18.0
      - run: databricks bundle validate --target staging

  deploy-staging:
    runs-on: ubuntu-latest
    needs: bundle-validate
    if: {% raw %}github.ref == 'refs/heads/main'{% endraw %}
    environment: staging
    steps:
      - uses: actions/checkout@v7

      - uses: astral-sh/setup-uv@v10.2.0  # Python version read from .python-version

      - uses: databricks/setup-cli@v1.18.0

      # The bundle builds the wheel itself (see artifacts in databricks.yml)
      - name: Deploy to staging
        run: databricks bundle deploy --target staging

  deploy-prod:
    runs-on: ubuntu-latest
    needs: bundle-validate
    if: {% raw %}startsWith(github.ref, 'refs/tags/v'){% endraw %}
    environment: production  # add required reviewers on this environment in GitHub
    steps:
      - uses: actions/checkout@v7

      - uses: astral-sh/setup-uv@v10.2.0  # Python version read from .python-version

      - uses: databricks/setup-cli@v1.18.0

      - name: Deploy to production
        run: databricks bundle deploy --target prod
